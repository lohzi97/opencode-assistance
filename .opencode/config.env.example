# Managed by ./config.sh
# Brave Search MCP configuration for opencode-assistant.
BRAVE_API_KEY=__BRAVE_API_KEY__
# OpenCode web/TUI basic auth password. Leave empty to run unsecured.
OPENCODE_SERVER_PASSWORD=__OPENCODE_SERVER_PASSWORD__
# OpenChamber (web frontend) configuration.
OPENCHAMBER_PORT=__OPENCHAMBER_PORT__
OPENCHAMBER_HOST=__OPENCHAMBER_HOST__
OPENCHAMBER_UI_PASSWORD=__OPENCHAMBER_UI_PASSWORD__
