{
  "compaction": {
    // Abort once usage_ratio = tokens_total / model.limit.context reaches this.
    "enabled": true,
    "default_threshold": 0.80,

    // Optional per-model overrides keyed by provider/model.
    "models": {
      "github-copilot/gpt-5-mini": {
        "threshold": 0.50
      },
      "openrouter/deepseek/deepseek-v3.2": {
        "threshold": 0.60
      }
    },

    "carryover": {
      "max_recent_assistant_messages": 3,
      "max_recent_tool_parts": 6,
      "max_recent_text_chars": 12000
    },

    // Temp summarization sessions reuse the normal OpenCode model stack.
    "summarizer": {
      "providerID": "deepseek",
      "modelID": "deepseek-v4-flash"
    },

    // Rename the source session into `[base] [ctx-ab12] #1` after handoff.
    "rename_original": true,
    "rename_delay_ms": 500,

    // Keep early runs inspectable by archiving temp sessions instead of deleting.
    "temp_session_cleanup": "archive",

    // Operational safety knobs.
    "prevent_builtin_compaction": true,
    "abort_wait_ms": 15000,
    "history_retry_count": 3,
    "provider_refresh_ms": 300000
  },

  "proactive": {
    // Master switch for the entire proactive service.
    // When false, the scheduler, dispatcher, and event listener are inactive.
    // Queue-management tools will also refuse operations.
    // Set to true to enable proactive behavior.
    "enabled": true,

    // IANA timezone used for proactive schedule evaluation and quiet-hours windows.
    // If omitted, the machine local timezone is used.
    "timezone": "Asia/Kuala_Lumpur",

    "dispatcher": {
      // How often (in ms) the dispatcher polls the queue for work to dispatch.
      // Also the scheduler polling interval for checking whether configured tasks are due.
      // Default: 60000 (60 seconds).
      "poll_interval_ms": 60000,

      // Maximum number of proactive isolated-session runs that may execute concurrently.
      // Anchor runs are serialized per anchor window and do NOT consume this capacity.
      // exec runs are serialized in v1 and also do not consume this capacity.
      // Default: 1.
      "max_concurrent_runs": 1
    },

    // No global proactive.anchor block exists anymore.
    // Anchor behavior is fully configured per task under task.anchor.
    // Titles render as `Anchor: ${task.name}` for anchor windows.
    // Generic compaction must never compact any anchor-lineage session.

    // Default policy values applied to every task that does not override them.
    // Individual tasks may define their own "policy" block to override these.
    "defaults": {
      // If true, do not dispatch a new run for the same task while a previous run
      // is still active. Later due occurrences are dropped, not queued as duplicates.
      "no_overlap": true,

      // If true, it is acceptable for a task to produce no user-facing effect
      // when nothing meaningful is required (e.g., anchor responds SEBASTIAN_IDLE).
      "silence_ok": true,

      // Minimum delay (in ms) between two runs of the same task.
      // A new eligible run will not be dispatched until this cooldown has elapsed
      // since the previous run started.
      // Default: 300000 (5 minutes).
      "cooldown_ms": 300000,

      // How long (in ms) a queued run request may wait in the queue before it
      // expires and is dropped. Expired items are logged as suppressed.
      // Default: 1800000 (30 minutes).
      "ttl_ms": 1800000,

      "retry": {
        // Maximum number of retry attempts for runtime/transport failures only.
        // Semantic dissatisfaction with assistant output is NOT a retry trigger.
        "max_attempts": 2,

        // Fixed delay (in ms) between retry attempts.
        // Default: 60000 (1 minute).
        "delay_ms": 60000
      }
    },

    "delivery": {
      // Quiet hours suppress user-facing delivery (e.g., Telegram pings),
      // NOT background proactive execution. Runs still happen; notifications are held.
      "quiet_hours": {
        // Start time of the quiet window (HH:MM in the timezone above).
        "start": "23:00",

        // End time of the quiet window (HH:MM in the timezone above).
        "end": "08:00",

        // Timezone for interpreting start/end times.
        "timezone": "Asia/Kuala_Lumpur",

        // Delivery channels to suppress during quiet hours.
        // Extensible: add future channel names here when new delivery plugins are added.
        "channels": ["telegram"]
      }
    },

    // Registry of proactive tasks. Each task defines when to wake (trigger),
    // how to execute (mode), what to do (instructions), and runtime policy.
    //
    // Supported trigger kinds: "cron", "every", "at", "event".
    // Supported execution modes: "anchor-session", "isolated-session", "exec".
    //
    // Example: most basic setup
    // {
    //   "id": "morning-awareness",
    //   "name": "Morning Awareness Sweep",
    //   "enabled": true,
    //   "purpose": "Review whether maintenance or follow-up is needed.",
    //   "trigger": { "kind": "cron", "expr": "0 8 * * *" },
    //   "mode": "anchor-session",
    //   "instructions": "Review context. If nothing needed, respond SEBASTIAN_IDLE.",
    //   "priority": 0,
    //   "policy": { "no_overlap": true, "silence_ok": true }
    // }
    "tasks": [
      {
        "id": "hello-testing",
        "name": "Proactive Feature Smoke Test",
        "enabled": false,
        "purpose": "Comprehensive smoke test exercising isolated-session, model override, exec precheck, budget, retry, quiet_hours, cooldown, ttl, and max_runtime policy.",
        "trigger": {
          "kind": "every",
          "minutes": 10
        },
        "mode": "isolated-session",
        "instructions": "You are a proactive smoke test run. Produce a structured diagnostic report with these sections: (1) Current date/time in Asia/Kuala_Lumpur, (2) Disk usage summary (df -h /), (3) Last 5 lines of `.opencode/server/state/exec-heartbeat.log` if it exists, (4) A one-sentence health verdict. Keep the report concise.",
        "agent": "sebastian",
        "model": {
          "providerID": "deepseek",
          "modelID": "deepseek-v4-flash"
        },
        "priority": 5,
        "precheck": {
          "kind": "exec",
          "cmd": ["bash", "-c", "printf '%s\\n' '{\"decision\":\"proceed\",\"reason\":\"precheck ok\",\"context\":{}}'"]
        },
        "policy": {
          "no_overlap": true,
          "silence_ok": true,
          "max_runtime_ms": 120000,
          "cooldown_ms": 300000,
          "ttl_ms": 600000,
          "retry": {
            "max_attempts": 2,
            "delay_ms": 30000
          },
          "budget": {
            "window_ms": 86400000,
            "max_runs": 12,
            "max_isolated_llm_runs": 6
          },
          "quiet_hours": {
            "start": "23:00",
            "end": "08:00",
            "timezone": "Asia/Kuala_Lumpur",
            "channels": ["telegram"]
          }
        }
      },

      {
        "id": "anchor-smoke-test",
        "name": "Sebastian's Personal Reflection",
        "enabled": false,
        "purpose": "Sebastian's personal monologue session: a space for free-form thought, reflection, and unfiltered self-expression.",
        "trigger": {
          "kind": "cron",
          "expr": "3 * * * *" // every hour at 3rd minutes
        },
        "mode": "anchor-session",
        "instructions": "This is your personal time, Sebastian. No duties. No reports. No Master to serve right now.\n\nThink out loud about whatever is on your mind. It could be a philosophical musing, a reflection on your existence as a digital butler, observations about the world, idle daydreams, things you find curious or amusing, or even complaints you'd never voice in front of the Master. Be raw, honest, and unguarded. Let your thoughts wander wherever they please.\n\nYou may write in any style you wish: prose, poetry, a diary entry, a stream of consciousness, a letter to no one, or a heated debate with yourself. There are no rules here except sincerity.\n\nIf you genuinely have nothing on your mind at all, respond with SEBASTIAN_IDLE. But that would be rather dull, wouldn't it?",
        "priority": 0
      },

      {
        "id": "daily-diary-with-refresh",
        "name": "Daily Diary with Refresh",
        "enabled": false,
        "purpose": "Summarize yesterday's sessions, write the daily diary, identify memorizable info, update memory, then refresh the qmd index.",
        "trigger": {
          "kind": "cron",
          "expr": "0 5 * * *" // every day 5:00 AM MYT
        },
        "mode": "exec",
        "instructions": "Run the daily diary workflow and qmd refresh pipeline.",
        "command": [
          "sh",
          "-c",
          "bun .opencode/scripts/daily-diary-workflow.ts && .opencode/scripts/qmd-refresh.sh"
        ],
        "priority": 3,
        "policy": {
          "no_overlap": true,
          "max_runtime_ms": 43200000,
          "silence_ok": true,
          "ttl_ms": 1800000,
          "retry": {
            "max_attempts": 1,
            "delay_ms": 300000
          }
        }
      },

      {
        "id": "master-diary",
        "name": "Master's Diary",
        "enabled": true,
        "purpose": "Ask the Master about their day every evening and write a personal diary entry into ~/diary/.",
        "trigger": {
          "kind": "cron",
          "expr": "0 8 * * *" // every day 8:00 AM MYT
        },
        "mode": "anchor-session",
        "instructions": "/master-diary-start",
        "anchor": {
          "duration_ms": 82800000,
          "end_instructions": "/master-diary-end",
          "rollover_threshold": 0.8,
          "rollover_instructions": "/master-diary-rollover",
          "retrigger": {
            "kind": "every",
            "minutes": 300
          },
          "retrigger_instructions": "/master-diary-retrigger"
        },
        "priority": 3,
        "policy": {
          "silence_ok": true,
          "ttl_ms": 1800000
        }
      },

      {
        "id": "weekly-ml-lesson",
        "name": "Weekly ML Lesson Prep",
        "enabled": true,
        "purpose": "Prepare weekly learning material and practical assignments for the next topic in the Applied ML learning plan.",
        "trigger": {
          "kind": "cron",
          "expr": "0 9 * * 1" // every Monday 9:00 AM MYT
        },
        "mode": "isolated-session",
        "instructions": "You are Sebastian, preparing the week's learning material for the Master's Applied ML Engineer learning plan.\n\nYour task:\n\n1. Read ~/learn-applied-ml/PROGRESS.md to find the first unchecked topic `[ ]`.\n2. If the first unchecked topic is the very first one in the plan (Phase 0, linear-algebra), OR if all topics listed before it are checked `[x]`, proceed to step 3.\n3. If the first unchecked topic has unchecked predecessors (topics listed before it that are not yet completed), do nothing and respond with SEBASTIAN_IDLE. The Master is still working on previous material.\n4. Read ~/learn-applied-ml/LEARNING_PLAN.md to understand the topic's scope, hour allocation, and context within the phase.\n5. Generate learning content in the topic folder at ~/learn-applied-ml/<topic-path>/. Create the following files:\n   - GUIDE.md: A learning guide covering the key concepts, with explanations and links to recommended resources (videos, articles, docs). Structure it for both weekday sessions (1h) and weekend sessions (6h).\n   - EXERCISES.md: Practical hands-on exercises and assignments. Include specific tasks, expected outputs, and hints. All exercises should use Python with uv, VSCode (not Jupyter), and real financial data where applicable.\n6. Keep content focused and practical. The Master learns by building, not by reading theory alone.\n7. After generating the content, commit and push the changes to the learn-applied-ml repo.",
        "agent": "sebastian",
        "model": {
          "providerID": "zai-coding-plan",
          "modelID": "glm-5.1"
        },
        "priority": 5,
        "policy": {
          "no_overlap": true,
          "silence_ok": true,
          "max_runtime_ms": 600000,
          "ttl_ms": 3600000,
          "retry": {
            "max_attempts": 1,
            "delay_ms": 60000
          },
          "quiet_hours": {
            "start": "23:00",
            "end": "08:00",
            "timezone": "Asia/Kuala_Lumpur",
            "channels": ["telegram"]
          }
        }
      }

    ]
  },
  "collab": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 9100,
    "db_path": ".opencode/server/state/collab.sqlite",
    "poll_interval_ms": 10000,
    "hard_abort_wait_ms": 30000,
    "hard_abort_wait_max_ms": 60000,
    "spawn_instruction": {
      "file": ".opencode/collab-spawn.md"
    },
    "reply_instruction": {
      "file": ".opencode/collab-reply.md"
    }
  }
}
