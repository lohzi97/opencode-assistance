# Vision MCP Server - Environment Configuration
# Managed by config.sh - do not edit manually.

OPENROUTER_API_KEY=__OPENROUTER_API_KEY__
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Fallback Chain (comma-separated, tried in order)
OPENROUTER_MODELS=__OPENROUTER_MODELS__

# Retries per model before moving to the next in the chain
OPENROUTER_RETRY_PER_MODEL=5

# Delay between retries of the same model in milliseconds
OPENROUTER_RETRY_DELAY_MS=1500

# API Timeout (in milliseconds)
API_TIMEOUT=30000

# Image Processing Configuration
MAX_IMAGE_SIZE=10485760
IMAGE_QUALITY=85

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=production
