{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3",
  "small_model": "zai-coding-plan/glm-4.7",
  "default_agent": "sebastian",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "compaction": {
    "auto": false
  },
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": {
              "max_price": {
                "prompt": 0.04,
                "completion": 0.08
              },
              "only": ["relace"],
              "allow_fallbacks": false,
            }
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-pty"
  ],
  "permission": {
    "edit": {
      "AGENTS.md": "deny"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ],
    },
    "brave-search": {
      "enabled": false,
      "type": "remote",
      "url": "http://localhost:9999/mcp",
      "oauth": false
    },
    "computer-control": {
      "enabled": true,
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "../computer-control-mcp",
        "computer-control-mcp"
      ],
      "environment": {
        "HUMANIZE_ENABLED": "true"
      }
    },
    "google-workspace": {
      "enabled": true,
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory", "../google_workspace_mcp",
        "main.py",
        "--tools", "drive", "calendar",
        "--tool-tier", "extended"
      ],
      "environment": {
        "GOOGLE_CLIENT_SECRET_PATH": "/home/linux-mint/opencode-assistance/.opencode/gcp-oauth.keys.json",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      }
    },
    "imap": {
      "enabled": false,
      "type": "local",
      "command": [
        "node",
        "../imap-mcp-server/dist/index.js"
      ]
    },
    "vision-mcp": {
      "enabled": false,
      "type": "local",
      "command": [
        "node",
        "../vision-mcp/build/main.js"
      ],
      "timeout": 300000
    }
  }
}
